{
    "productName": "Sentinel",
    "version": "0.1.0",
    "identifier": "com.sentinel.app",
    "build": {
        "beforeDevCommand": "npm run desktop:backend && npm run dev",
        "beforeBuildCommand": "npm run desktop:backend && npm run build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [
            {
                "title": "Sentinel - AI File Organizer",
                "width": 1400,
                "height": 900,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false,
                "alwaysOnTop": false,
                "center": true,
                "minWidth": 380,
                "minHeight": 520,
                "skipTaskbar": false,
                "url": "dashboard"
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [],
        "externalBin": [
            "binaries/sentinel-backend"
        ],
        "copyright": "Copyright \u00a9 2026 Sentinel",
        "category": "Utility",
        "shortDescription": "AI-powered file organization",
        "longDescription": "Sentinel is a local-first AI agent that safely cleans and organizes your computer with intelligent file management.",
        "macOS": {
            "frameworks": [],
            "minimumSystemVersion": "12.0",
            "exceptionDomain": "",
            "signingIdentity": null,
            "entitlements": null
        },
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": "",
            "wix": {
                "language": "en-US"
            }
        }
    }
}
